PORT=4001
INTERNAL_API_TOKEN=change-me-internal-shared-secret

# Primary provider (openai | claude | ollama) — default openai
AI_PROVIDER=openai

# OpenAI (default primary)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Claude (optional alternate)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama (optional offline alternate)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.1:8b

# TTS (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Voice cache
VOICE_CACHE_DIR=./voice-cache
VOICE_CACHE_TTL_HOURS=24
VOICE_PUBLIC_BASE_URL=

# Optional Ollama TTS
OLLAMA_TTS_MODEL=

# Logging
LOG_LEVEL=info
