# ==============================================================================
# PROJECT EXTRACTION — Backend environment configuration
# Copy to .env and replace placeholders with real values.
# Never commit .env.
# ==============================================================================

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=api
LOG_LEVEL=debug

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins. Use "*" only in dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# --- SQLite databases ---------------------------------------------------------
# Operational state (users, missions, rounds, events, ...) and high-volume
# telemetry are stored in two separate SQLite files to keep telemetry writes
# from blocking operational queries (each .db file has its own writer lock).
DATABASE_PATH=./data/operational.db
TELEMETRY_DATABASE_PATH=./data/telemetry.db
DATABASE_LOGGING=false

# --- JWT ----------------------------------------------------------------------
# REQUIRED: Generate with `openssl rand -base64 48` for production.
# Must be at least 32 characters.
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_this_with_another_long_random_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# --- ElevenLabs (TTS) ---------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_MS=10000

# --- Ollama (local fallback) --------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT_MS=15000

# --- bcrypt -------------------------------------------------------------------
BCRYPT_ROUNDS=12

# --- AI Service (separate microservice) ---------------------------------------
AI_SERVICE_URL=http://localhost:4001

# --- Telemetry HMAC verification ----------------------------------------------
# Enable once devices have registered keys. Until then signature checks pass.
HMAC_VERIFICATION_ENABLED=false
