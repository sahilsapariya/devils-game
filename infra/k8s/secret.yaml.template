# Template for sensitive backend configuration.
# DO NOT commit real values. Generate the real Secret with a sealed-secrets
# controller, External Secrets Operator, or `kubectl create secret` from a
# values file kept outside the repo.
#
# Example:
#   kubectl -n extraction create secret generic backend-secrets \
#     --from-literal=DATABASE_URL=... \
#     --from-literal=JWT_SECRET=... \
#     ...
apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
  namespace: extraction
type: Opaque
stringData:
  DATABASE_URL: "postgres://USER:PASSWORD@HOST:5432/DB"
  REDIS_URL: "rediss://USER:PASSWORD@HOST:6379"
  JWT_SECRET: "REPLACE_WITH_LONG_RANDOM_STRING"
  ELEVENLABS_API_KEY: "REPLACE_ME"
  ELEVENLABS_VOICE_ID: "REPLACE_ME"
  GITHUB_API_TOKEN: "REPLACE_ME"
  GITHUB_WEBHOOK_SECRET: "REPLACE_ME"
  S3_ACCESS_KEY_ID: "REPLACE_ME"
  S3_SECRET_ACCESS_KEY: "REPLACE_ME"
  SENTRY_DSN: ""
