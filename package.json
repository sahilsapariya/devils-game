{
  "name": "project-extraction",
  "version": "0.1.0",
  "private": true,
  "description": "PROJECT EXTRACTION - Cross-device behavioral operating system",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
