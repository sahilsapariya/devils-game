# =============================================================================
# PROJECT EXTRACTION — Production environment template
# =============================================================================
#
# Copy this file to `.env.production` on your VPS and fill in the placeholders.
# This file MUST be readable only by root on the VPS:
#
#   sudo chown root:root /opt/extraction/.env.production
#   sudo chmod 600       /opt/extraction/.env.production
#
# Generate strong secrets with:  openssl rand -hex 32
# =============================================================================


# -----------------------------------------------------------------------------
# Deployment / TLS
# -----------------------------------------------------------------------------

# Public hostname the operator and clients connect to. Used by Caddy for ACME.
# REQUIRED. No protocol, no trailing slash. Example: extraction.example.com
DOMAIN=extraction.example.com

# Email address registered with Let's Encrypt for cert issuance notices.
# REQUIRED. Use an inbox you actually monitor.
ACME_EMAIL=admin@example.com


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=warn           # one of: fatal | error | warn | info | debug | trace
PORT=3001                # backend listens here (internal; not host-exposed)


# -----------------------------------------------------------------------------
# Backend — authentication secrets (REQUIRED, rotate occasionally)
# -----------------------------------------------------------------------------

# Symmetric secret for signing short-lived JWT access tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# Symmetric secret for signing long-lived refresh tokens.
# Generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=REPLACE_WITH_openssl_rand_hex_32

# Shared secret presented by the backend when calling the ai-service over the
# internal Docker network (X-Internal-Token header).
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=REPLACE_WITH_openssl_rand_hex_32


# -----------------------------------------------------------------------------
# Backend — SQLite databases
# -----------------------------------------------------------------------------

# Both files live on the bind-mounted host volume at /opt/extraction/data/.
DATABASE_PATH=/app/data/operational.db
TELEMETRY_DATABASE_PATH=/app/data/telemetry.db


# -----------------------------------------------------------------------------
# Backend — CORS / registration policy
# -----------------------------------------------------------------------------

# Comma-separated list of origins allowed by the API. For single-domain setups
# this is just your Caddy host. Add additional origins (browser extension
# packaged URL, mobile bundle origin) as needed.
CORS_ORIGINS=https://${DOMAIN}

# Allow new operator accounts to register via /api/auth/register.
# Recommended: leave as `true` until you create your account, then set to
# `false` and redeploy so no one else can register.
ALLOW_REGISTRATION=true

# Email of the primary human operator. Informational only — not consumed by
# code, just used by docs/runbooks.
OPERATOR_EMAIL=operator@example.com


# -----------------------------------------------------------------------------
# AI service — wiring
# -----------------------------------------------------------------------------

# Internal Docker DNS — the backend calls the ai-service via this URL.
# Do NOT change unless you rename the docker-compose service.
AI_SERVICE_URL=http://ai-service:4001

# Which LLM backend the ai-service should use. Currently only `openai`.
AI_PROVIDER=openai


# -----------------------------------------------------------------------------
# AI service — OpenAI (REQUIRED)
# -----------------------------------------------------------------------------

# Obtain from https://platform.openai.com/api-keys
# REQUIRED. Pricing visible at https://openai.com/api/pricing/
OPENAI_API_KEY=sk-REPLACE_WITH_OPENAI_API_KEY

# Model identifier. Default is the cost-optimised nano tier.
OPENAI_MODEL=gpt-5.4-nano


# -----------------------------------------------------------------------------
# AI service — ElevenLabs voice (OPTIONAL)
# -----------------------------------------------------------------------------
# Skip these two if you don't need text-to-speech. The ai-service will fall
# back to text-only responses when no key is configured.

# Obtain from https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=

# Voice ID to render speech with. Browse voices at
# https://elevenlabs.io/app/voice-library
# ELEVENLABS_VOICE_ID=


# -----------------------------------------------------------------------------
# Telemetry verification
# -----------------------------------------------------------------------------

# When `true`, the backend rejects telemetry that fails per-device HMAC
# verification. Leave this as `false` until device enrollment is wired
# end-to-end (otherwise legitimate desktop-agent / extension events will be
# dropped). Re-enable after enrollment ships.
HMAC_VERIFICATION_ENABLED=false
